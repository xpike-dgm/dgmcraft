# DGM Craft Turkce komutlar v2 - Skript ile /xxxx -> /yyyy esleme
# Kullanim: /turkcekomut [arguman] calisir, gercek komut arkada kosar.
# Tum oyuncular kullanabilir (ozel izin gerekmez).

command /ev [<text>]:
	description: Evine isinlanirsin.
	trigger:
		make player execute command "home %arg-1%"

command /evkur <text>:
	description: Ev noktasi kaydedersin.
	trigger:
		make player execute command "sethome %arg-1%"

command /evsil <text>:
	description: Ev kaydini silersin.
	trigger:
		make player execute command "delhome %arg-1%"

command /dogum:
	description: Dogus noktasina gidersin.
	trigger:
		make player execute command "spawn"

command /istek <player>:
	description: Oyuncuya isinlanma istegi gonderirsin.
	trigger:
		make player execute command "tpa %arg-1%"

command /kabul:
	description: Gelen istegi kabul edersin.
	trigger:
		make player execute command "tpaccept"

command /red:
	description: Gelen istegi reddedersin.
	trigger:
		make player execute command "tpdeny"

command /cagir <player>:
	description: Oyuncuyu yanina cagirirsin.
	trigger:
		make player execute command "tpahere %arg-1%"

command /don:
	description: Onceki konumuna donersin.
	trigger:
		make player execute command "back"

command /tepe:
	description: En ust bloga cikarsin.
	trigger:
		make player execute command "essentials:top"

command /para:
	description: Bakiyeni gosterir.
	trigger:
		make player execute command "money"

command /ode <player> <number>:
	description: Oyuncuya para gonderirsin.
	trigger:
		make player execute command "pay %arg-1% %arg-2%"

command /sat:
	description: Elindekini satarsin.
	trigger:
		make player execute command "sell hand"

command /deger:
	description: Elindekinin fiyatini gosterir.
	trigger:
		make player execute command "worth"

command /zenginler:
	description: En zenginleri listeler.
	trigger:
		make player execute command "balancetop"

command /kitler:
	description: Kit listesini gosterir.
	trigger:
		make player execute command "kits"

command /goster <text>:
	description: Kit icerigini onizlersin.
	trigger:
		make player execute command "showkit %arg-1%"

command /gorevler:
	description: Gorev menusunu acar.
	trigger:
		make player execute command "quests"

command /yetenek:
	description: Yetenek menusunu acar.
	trigger:
		make player execute command "skills"

command /yardim:
	description: Yardimi gosterir.
	trigger:
		make player execute command "help"

command /kurallar:
	description: Kurallari gosterir.
	trigger:
		make player execute command "rules"

command /tamir:
	description: Elindekini tamir eder (50 para).
	trigger:
		make player execute command "repair"

command /calisma:
	description: Seyyar calisma masasi acar.
	trigger:
		make player execute command "workbench"

command /pusula:
	description: Yonu gosterir.
	trigger:
		make player execute command "compass"

